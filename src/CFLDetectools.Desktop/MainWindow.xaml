<Window x:Class="CFLDetectools.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CFLDetectools — Pump Monitor" Height="540" Width="1050"
        MinHeight="480" MinWidth="900" Background="#F3F5F8"
        Loaded="OnLoaded" Closed="OnClosed">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="CFLDetectools" FontSize="28" FontWeight="SemiBold" Foreground="#17344D" />
            <TextBlock Text="Siemens PLC / Pump status and control" FontSize="14" Margin="0,5,0,16" />
        </StackPanel>
        <Border Grid.Row="1" Background="#FFF0C2" Padding="12" Margin="0,0,0,16" CornerRadius="5">
            <TextBlock Text="SIMULATION MODE — All signals and commands are in memory. No PLC is connected."
                       TextWrapping="Wrap" FontWeight="SemiBold" />
        </Border>
        <DataGrid x:Name="Pumps" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                  SelectionChanged="OnSelectionChanged" RowHeight="38" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Pump" Binding="{Binding Id}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="*" />
                <DataGridCheckBoxColumn Header="Ready" Binding="{Binding Ready}" Width="85" />
                <DataGridCheckBoxColumn Header="Fault" Binding="{Binding Fault}" Width="85" />
                <DataGridCheckBoxColumn Header="Remote" Binding="{Binding RemoteMode}" Width="85" />
                <DataGridTextColumn Header="Sample time (UTC)" Binding="{Binding ObservedAt, StringFormat=HH:mm:ss}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,12">
            <Button x:Name="StartButton" Content="Start selected (simulation)" Padding="16,9"
                    IsEnabled="False" Click="OnStart" Margin="0,0,12,0" />
            <Button x:Name="StopButton" Content="Stop selected (simulation)" Padding="16,9"
                    IsEnabled="False" Click="OnStop" />
        </StackPanel>
        <StackPanel Grid.Row="4">
            <TextBlock x:Name="ConnectionText" Text="Simulator disconnected" FontWeight="SemiBold" />
            <TextBlock x:Name="MessageText" Text="Select a pump to try simulated control."
                       TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
    </Grid>
</Window>
